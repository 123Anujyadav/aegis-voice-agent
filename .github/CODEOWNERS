# =============================================================================
# CODEOWNERS — every directory has an owner.
#
# Phase 1 monorepo guideline #1: "Every directory has an owner. Unowned code
# rots. No exceptions." GitHub requires listed owners to approve changes to
# their paths when branch protection has "Require review from Code Owners" on.
#
# Ordering matters: the LAST matching pattern wins. General rules first,
# specific overrides after.
#
# NOTE FOR BOOTSTRAP: teams below must exist in the GitHub org before branch
# protection can enforce this file. Until the org is provisioned, replace team
# handles with individual @usernames. The structure does not change.
# =============================================================================

# --- Default owner for anything not matched below ---------------------------
*                                   @callscreen/platform

# --- Repository-wide engineering policy -------------------------------------
# Changing conventions, gates, or the build contract requires architecture review.
/.editorconfig                      @callscreen/platform @callscreen/architecture
/.gitattributes                     @callscreen/platform
/Taskfile.yml                       @callscreen/platform
/.pre-commit-config.yaml            @callscreen/platform
/commitlint.config.mjs              @callscreen/platform
/renovate.json5                     @callscreen/platform
/package.json                       @callscreen/platform

# --- CI/CD: changes here can bypass quality gates ---------------------------
/.github/                           @callscreen/platform
/.github/workflows/                 @callscreen/platform @callscreen/security
/.github/CODEOWNERS                 @callscreen/architecture

# --- Contracts: THE integration boundary ------------------------------------
# Owned by architecture, not by any single consuming service. A breaking change
# here breaks Android clients that will not update for months (Phase 1 §14).
/contracts/                         @callscreen/architecture @callscreen/platform
/contracts/proto/callscreen/common/ @callscreen/architecture @callscreen/security

# --- Shared packages: a bug here is an incident in every service ------------
/packages/                          @callscreen/platform
/packages/go/platform/              @callscreen/platform @callscreen/observability
/packages/python/platform/          @callscreen/platform @callscreen/observability
/packages/go/eventbus/              @callscreen/platform @callscreen/data
/packages/python/ai-primitives/     @callscreen/ai

# --- Generated bindings: never hand-edited; regeneration is CI-verified -----
/packages/go/contracts-go/          @callscreen/platform
/packages/python/contracts-py/      @callscreen/platform
/packages/kotlin/contracts-kt/      @callscreen/platform
/packages/ts/contracts-ts/          @callscreen/platform

