<?xml version="1.0" encoding="utf-8" ?>
<!--
  Application manifest.

  This declares the application class and its one activity. Components and
  permissions arrive with the module that actually uses them, so that every
  entry in the shipped manifest is traceable to the code that needs it:
  core:telephony declares the CallScreeningService and READ_CONTACTS, and
  core:network declares INTERNET; both are merged into this one. Declaring a
  permission the app does not use is both a Play Store policy risk and a
  privacy-review finding, and app/release-permissions.txt (checked in CI)
  pins the merged list.

  In particular the telephony permissions (READ_PHONE_STATE, ANSWER_PHONE_CALLS)
  are deliberately absent.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name="com.callscreen.app.CallScreenApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallScreen"
        tools:targetApi="34"
        xmlns:tools="http://schemas.android.com/tools">

        <!--
          allowBackup is false deliberately. Android's automatic backup would
          copy application data to the user's cloud account, which for this
          product would mean call metadata and contact information leaving the
          India region — a direct conflict with the data-residency requirement
          in Phase 1 assumption A2 and with DPDP obligations.

          On Android 12+ allowBackup="false" no longer stops a device-to-device
          transfer, so dataExtractionRules excludes every domain from both cloud
          backup and device transfer (res/xml/data_extraction_rules.xml).

          It is set here, once, at the shell, rather than being left to whichever
          module first happens to think about it.
        -->

        <activity
            android:name="com.callscreen.app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CallScreen">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>


</manifest>
