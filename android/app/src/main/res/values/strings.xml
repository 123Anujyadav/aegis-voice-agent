<?xml version="1.0" encoding="utf-8" ?>
<!--
  Default (English) string resources for the application shell.

  Only strings genuinely owned by the shell live here. Feature strings belong to
  their feature module, so that deleting a feature deletes its copy with it and
  the catalogue cannot accumulate orphans.

  Localisation note: the product ships India-first, so translations land in
  values-hi, values-bn, values-ta, values-te and values-mr. The resource
  configuration in the application convention plugin restricts the packaged set
  to exactly those locales.
-->
<resources>

    <!-- Launcher label. Not translated: the product name is a proper noun. -->
    <string name="app_name" translatable="false">CallScreen</string>

    <!-- A73 Signed out (docs/ux/android/06-screens-onboarding-auth-permissions.md, "A73 as built").
         A reason is given only when the app knows it. -->
    <string name="app_signed_out_title">You\'re signed out on this device.</string>
    <string name="app_signed_out_you_signed_out">You signed out.</string>
    <string name="app_signed_out_not_verified">We couldn\'t verify this device.</string>
    <string name="app_signed_out_blocking_still_on">On-device blocking is still on.</string>
    <string name="app_signed_out_sign_in">Sign in</string>

</resources>
