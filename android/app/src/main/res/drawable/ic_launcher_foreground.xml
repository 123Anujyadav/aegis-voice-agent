<?xml version="1.0" encoding="utf-8" ?>
<!--
  Launcher icon foreground.

  A vector rather than a set of raster densities: one file replaces six PNGs and
  scales to any density, which matters directly because APK size is a release
  gate (Phase 1 SS17) and launcher assets are pure overhead in every install.

  The 108dp canvas with artwork inside the central 72dp is mandated by the
  adaptive-icon spec: the outer ring is cropped by whichever mask the launcher
  applies, so anything drawn there is not guaranteed to be visible.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
