<?xml version="1.0" encoding="utf-8" ?>
<!--
  Adaptive launcher icon (API 26+).

  minSdk is 26, so the legacy raster mipmaps that older projects still carry are
  unnecessary. Every launcher this app can be installed on supports adaptive
  icons, which is one of the concrete simplifications the minSdk decision buys.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>