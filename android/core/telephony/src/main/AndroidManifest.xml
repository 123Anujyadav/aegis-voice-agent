<?xml version="1.0" encoding="utf-8" ?>
<!--
  The on-device pre-filter (ADR-0002 Stage 1), declared by the module that
  implements it.

  The service is exported because the system binds to it, and it is protected
  by BIND_SCREENING_SERVICE, a permission only the system holds, so no other
  app can bind it. It does nothing until the user gives this app the call
  screening role (RoleManager.ROLE_CALL_SCREENING, Android 10 and later).

  One user permission, READ_CONTACTS, and only as Android's switch: without
  it, Android lets calls from contacts ring without passing them to the
  service, so a saved contact cannot be blocked. It is requested only when the
  subscriber asks to block saved contacts too (blocklist screen), and the app
  never reads the contacts provider or uploads contacts (ContactsAccess; a
  test fails if production code queries it). The role is not a permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application>
        <service
            android:name="com.callscreen.core.telephony.screening.PreFilterScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
    </application>

</manifest>
